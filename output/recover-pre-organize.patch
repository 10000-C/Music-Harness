+/* ==========================================================================
+   IMPECCABLE & APPLE LIQUID GLASS SUPREME DESIGN SYSTEM OVERRIDES
+   ========================================================================== */
+
+/* 1. Global Shell & Ambient Mesh Depth */
+.workstation-shell {
+  background: radial-gradient(circle at 50% -15%, #1f1a3a 0%, #06070a 75%) !important;
+  color-scheme: dark;
+}
+
+.workspace-main {
+  background: transparent !important;
+}
+
+/* 2. Top Project Header */
+.project-header {
+  display: flex !important;
+  align-items: center !important;
+  justify-content: space-between !important;
+  padding: 0 24px !important;
+  height: 68px !important;
+  background: rgba(10, 12, 18, 0.4) !important;
+  backdrop-filter: blur(36px) saturate(170%) !important;
+  -webkit-backdrop-filter: blur(36px) saturate(170%) !important;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
+  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2) !important;
+}
+
+/* 3. Left Navigation Sidebar */
+.project-sidebar {
+  background: rgba(12, 14, 20, 0.45) !important;
+  backdrop-filter: blur(40px) saturate(170%) !important;
+  -webkit-backdrop-filter: blur(40px) saturate(170%) !important;
+  border-right: 1px solid rgba(255, 255, 255, 0.05) !important;
+  box-shadow: inset -1px 0 0 rgba(255, 255, 255, 0.02) !important;
+}
+
+.brand-lockup {
+  border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
+}
+
+.sidebar-navigation__item {
+  border-radius: 10px !important;
+  transition: all 140ms cubic-bezier(0.16, 1, 0.3, 1) !important;
+}
+
+.sidebar-navigation__item:active {
+  transform: scale(0.96) !important;
+}
+
+.sidebar-navigation__item[aria-current='page'] {
+  background: rgba(255, 255, 255, 0.08) !important;
+  color: #fff !important;
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 2px 8px rgba(0, 0, 0, 0.25) !important;
+}
+
+/* 4. Master Transport Island (Unified Top Center Musical Dynamic Island) */
+.master-transport-island {
+  position: relative;
+  display: flex !important;
+  align-items: center !important;
+  gap: 8px !important;
+  padding: 4px 14px 4px 10px !important;
+  border-radius: 999px !important;
+  background: rgba(22, 24, 34, 0.65) !important;
+  backdrop-filter: blur(36px) saturate(180%) !important;
+  -webkit-backdrop-filter: blur(36px) saturate(180%) !important;
+  border: 1px solid rgba(255, 255, 255, 0.09) !important;
+  box-shadow:
+    0 16px 36px rgba(0, 0, 0, 0.45),
+    inset 0 1px 0 rgba(255, 255, 255, 0.15),
+    0 0 0 1px rgba(167, 139, 250, 0.08) !important;
+  transition: all 180ms ease !important;
+}
+
+.master-transport-island:hover {
+  border-color: rgba(255, 255, 255, 0.14) !important;
+  box-shadow:
+    0 18px 40px rgba(0, 0, 0, 0.55),
+    inset 0 1px 0 rgba(255, 255, 255, 0.2),
+    0 0 16px rgba(167, 139, 250, 0.12) !important;
+}
+
+.master-transport-island__cluster {
+  display: flex !important;
+  align-items: center !important;
+  gap: 2px !important;
+}
+
+.master-transport-island__btn {
+  display: flex !important;
+  align-items: center !important;
+  justify-content: center !important;
+  width: 28px !important;
+  height: 28px !important;
+  padding: 0 !important;
+  border-radius: 50% !important;
+  background: transparent !important;
+  border: none !important;
+  color: #9499ab !important;
+  cursor: pointer !important;
+  transition: all 140ms cubic-bezier(0.16, 1, 0.3, 1) !important;
+}
+
+.master-transport-island__btn:hover:not(:disabled) {
+  color: #ffffff !important;
+  background: rgba(255, 255, 255, 0.08) !important;
+}
+
+.master-transport-island__btn:active:not(:disabled) {
+  transform: scale(0.9) !important;
+}
+
+.master-transport-island__btn.is-active {
+  color: #c084fc !important;
+  background: rgba(192, 132, 252, 0.15) !important;
+}
+
+/* The Luminous Violet Orb Play Button */
+.master-transport-island__play {
+  position: relative !important;
+  display: flex !important;
+  align-items: center !important;
+  justify-content: center !important;
+  width: 38px !important;
+  height: 38px !important;
+  border-radius: 50% !important;
+  background: linear-gradient(135deg, #a78bfa, #f472b6) !important;
+  color: #090a0f !important;
+  border: none !important;
+  cursor: pointer !important;
+  box-shadow:
+    0 0 20px rgba(167, 139, 250, 0.5),
+    inset 0 1px 0 rgba(255, 255, 255, 0.4) !important;
+  transition:
+    transform 150ms cubic-bezier(0.16, 1, 0.3, 1),
+    filter 150ms ease,
+    box-shadow 150ms ease !important;
+}
+
+.master-transport-island__play:hover:not(:disabled) {
+  filter: brightness(1.12) !important;
+  transform: scale(1.06) !important;
+  box-shadow:
+    0 0 26px rgba(167, 139, 250, 0.7),
+    0 0 10px rgba(244, 114, 182, 0.5),
+    inset 0 1px 0 rgba(255, 255, 255, 0.6) !important;
+}
+
+.master-transport-island__play:active:not(:disabled) {
+  transform: scale(0.9) !important;
+}
+
+.master-transport-island__play[aria-pressed='true'] {
+  animation: orb-playing-glow 2s ease-in-out infinite alternate !important;
+}
+
+@keyframes orb-playing-glow {
+  0% {
+    box-shadow:
+      0 0 18px rgba(167, 139, 250, 0.45),
+      0 0 6px rgba(244, 114, 182, 0.3),
+      inset 0 1px 0 rgba(255, 255, 255, 0.35) !important;
+  }
+  100% {
+    box-shadow:
+      0 0 28px rgba(167, 139, 250, 0.75),
+      0 0 14px rgba(244, 114, 182, 0.55),
+      inset 0 1px 0 rgba(255, 255, 255, 0.6) !important;
+  }
+}
+
+.master-transport-island__divider {
+  width: 1px !important;
+  height: 20px !important;
+  margin: 0 4px !important;
+  background: rgba(255, 255, 255, 0.08) !important;
+}
+
+.master-transport-island__readout {
+  display: flex !important;
+  align-items: center !important;
+  gap: 12px !important;
+  padding-left: 2px !important;
+}
+
+.master-transport-island__time {
+  display: flex !important;
+  align-items: baseline !important;
+  gap: 4px !important;
+  font-feature-settings: 'tnum' !important;
+  font-variant-numeric: tabular-nums !important;
+  font-family: 'Geist', 'SF Pro Display', ui-sans-serif, sans-serif !important;
+}
+
+.master-transport-island__time strong {
+  font-size: 13px !important;
+  font-weight: 600 !important;
+  color: #ffffff !important;
+  letter-spacing: -0.01em !important;
+}
+
+.master-transport-island__time small {
+  font-size: 10px !important;
+  font-weight: 500 !important;
+  color: #787f92 !important;
+}
+
+.master-transport-island__metric {
+  display: flex !important;
+  align-items: center !important;
+  gap: 7px !important;
+  padding: 3px 8px !important;
+  border-radius: 999px !important;
+  background: rgba(255, 255, 255, 0.04) !important;
+  border: 1px solid rgba(255, 255, 255, 0.05) !important;
+}
+
+.master-transport-island__beat {
+  width: 6px !important;
+  height: 6px !important;
+  border-radius: 50% !important;
+  background: #687084 !important;
+  transition: all 120ms ease !important;
+}
+
+.master-transport-island__beat.is-beating {
+  background: #a78bfa !important;
+  box-shadow: 0 0 8px #a78bfa !important;
+  animation: metronome-pulse 0.5s ease-in-out infinite alternate !important;
+}
+
+@keyframes metronome-pulse {
+  0% {
+    transform: scale(0.8);
+    opacity: 0.5;
+  }
+  100% {
+    transform: scale(1.3);
+    opacity: 1;
+  }
+}
+
+.master-transport-island__bpm {
+  font-size: 11px !important;
+  font-weight: 600 !important;
+  color: #d1d5db !important;
+  letter-spacing: 0.02em !important;
+}
+
+.master-transport-island__meter {
+  font-size: 10px !important;
+  font-weight: 500 !important;
+  color: #8b92a4 !important;
+}
+
+/* 5. Right Live Agent Panel */
+.agent-panel {
