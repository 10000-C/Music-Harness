+  box-shadow: 0 0 10px var(--track-color, #a783ff) !important;
+  filter: brightness(1.2) saturate(1.2) !important;
+}
+
+
+
+/* 3. Right Agent Chat Polish */
+.agent-chat__message {
+  border-radius: 16px 16px 16px 4px !important;
+  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03)) !important;
+  border: 1px solid rgba(255, 255, 255, 0.06) !important;
+  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15), inset 0 1px 1px rgba(255, 255, 255, 0.08) !important;
+  font-size: 12px !important;
+  padding: 12px 16px !important;
+}
+
+.agent-chat__message--error {
+  background: linear-gradient(135deg, rgba(220, 38, 38, 0.15), rgba(220, 38, 38, 0.05)) !important;
+  border-color: rgba(220, 38, 38, 0.2) !important;
+}
+
+.agent-composer textarea {
+  background: rgba(0, 0, 0, 0.2) !important;
+  border: 1px solid rgba(255, 255, 255, 0.08) !important;
+  border-radius: 16px !important;
+  box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.3) !important;
+  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
+  font-size: 12px !important;
+}
+
+.agent-composer textarea:focus-visible {
+  background: rgba(0, 0, 0, 0.4) !important;
+  border-color: rgba(155, 130, 255, 0.4) !important;
+  box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.4), 0 0 0 2px rgba(155, 130, 255, 0.15) !important;
+}
+
+/* ==========================================================================
+   IMPECCABLE OVERRIDES: PHASE 11 (COLLAPSIBLE DOCK & HARDWARE TONE CONSOLE)
+   ========================================================================== */
+
+/* 1. Tone Console Hardware Mute/Solo & Actions */
+.tone-console__actions {
+  display: flex !important;
+  align-items: center !important;
+  gap: 6px !important;
+}
+
+.tone-console__actions button {
+  height: 24px !important;
+  min-width: 46px !important;
+  padding: 0 10px !important;
+  font-size: 9px !important;
+  font-weight: 700 !important;
+  letter-spacing: 0.05em !important;
+  border-radius: 6px !important;
+  background: rgba(0, 0, 0, 0.45) !important;
+  border: 1px solid rgba(255, 255, 255, 0.08) !important;
+  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.4) !important;
+  color: rgba(255, 255, 255, 0.45) !important;
+  cursor: pointer !important;
+  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
+}
+
+.tone-console__actions button:hover {
+  color: #fff !important;
+  background: rgba(255, 255, 255, 0.08) !important;
+}
+
+.tone-console__actions button:active {
+  transform: scale(0.92) !important;
+}
+
+/* Amber Mute Active */
+.tone-console__actions button:first-child[aria-pressed='true'] {
+  background: rgba(217, 119, 6, 0.85) !important;
+  color: #fff !important;
+  border-color: rgba(245, 158, 11, 0.5) !important;
+  box-shadow: 0 0 14px rgba(217, 119, 6, 0.65), inset 0 1px 1px rgba(255, 255, 255, 0.4) !important;
+  text-shadow: 0 0 4px rgba(255, 255, 255, 0.8) !important;
+}
+
+/* Emerald Solo Active */
+.tone-console__actions button:nth-child(2)[aria-pressed='true'] {
+  background: rgba(5, 150, 105, 0.85) !important;
+  color: #fff !important;
+  border-color: rgba(16, 185, 129, 0.5) !important;
+  box-shadow: 0 0 14px rgba(5, 150, 105, 0.65), inset 0 1px 1px rgba(255, 255, 255, 0.4) !important;
+  text-shadow: 0 0 4px rgba(255, 255, 255, 0.8) !important;
+}
+
+/* Tone Console Close Button */
+.tone-console__actions .tone-console__close-btn {
+  min-width: 24px !important;
+  width: 24px !important;
+  height: 24px !important;
+  padding: 0 !important;
+  margin-left: 4px !important;
+  font-size: 16px !important;
+  font-weight: 400 !important;
+  line-height: 1 !important;
+  border-radius: 6px !important;
+  background: rgba(255, 255, 255, 0.04) !important;
+  border: 1px solid rgba(255, 255, 255, 0.06) !important;
+  color: rgba(255, 255, 255, 0.4) !important;
+}
+
+.tone-console__actions .tone-console__close-btn:hover {
+  background: rgba(255, 255, 255, 0.12) !important;
+  color: #fff !important;
+  transform: scale(0.96) !important;
+}
+
+/* 2. Docked Miniature Floating Pill (When Collapsed) */
+.tone-console-dock {
+  position: absolute !important;
+  bottom: 20px !important;
+  left: 50% !important;
+  transform: translateX(-50%) !important;
+  z-index: 100 !important;
+  pointer-events: auto !important;
+  animation: toneDockFloat 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
+}
+
+@keyframes toneDockFloat {
+  from {
+    opacity: 0;
+    transform: translate(-50%, 12px) scale(0.96);
+  }
+  to {
+    opacity: 1;
+    transform: translate(-50%, 0) scale(1);
+  }
+}
+
+.tone-console-dock__pill {
+  display: flex !important;
+  align-items: center !important;
+  gap: 10px !important;
+  height: 34px !important;
+  padding: 0 12px 0 12px !important;
+  background: rgba(18, 18, 24, 0.75) !important;
+  backdrop-filter: blur(32px) saturate(160%) !important;
+  -webkit-backdrop-filter: blur(32px) saturate(160%) !important;
+  border: 1px solid rgba(255, 255, 255, 0.08) !important;
+  border-radius: 999px !important;
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
+  color: rgba(255, 255, 255, 0.75) !important;
+  font-size: 11px !important;
+  cursor: pointer !important;
+  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
+}
+
+.tone-console-dock__pill:hover {
+  background: rgba(28, 28, 38, 0.9) !important;
+  border-color: rgba(255, 255, 255, 0.18) !important;
+  color: #fff !important;
+  transform: scale(1.03) !important;
+  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.2) !important;
+}
+
+.tone-console-dock__pill:active {
+  transform: scale(0.97) !important;
+}
+
+.tone-console-dock__icon {
+  font-size: 12px !important;
+}
+
+.tone-console-dock__title strong {
+  color: #fff !important;
+  font-weight: 600 !important;
+}
+
+.tone-console-dock__badge {
+  margin-left: 4px !important;
+  padding: 2px 7px !important;
+  font-size: 9px !important;
+  font-weight: 600 !important;
+  text-transform: uppercase !important;
+  letter-spacing: 0.05em !important;
+  border-radius: 999px !important;
+  background: rgba(255, 255, 255, 0.08) !important;
+  color: rgba(255, 255, 255, 0.6) !important;
+}
+
+/* ==========================================================================
+   IMPECCABLE OVERRIDES: PHASE 15 (PREMIUM ICONS & SLEEK SCROLLBARS)
+   ========================================================================== */
+
+/* 1. Global Scrollbar Hiding (Invisible but scrollable) */
+.workspace-content ::-webkit-scrollbar,
+.agent-chat__messages::-webkit-scrollbar,
+.arrangement-map__tracks::-webkit-scrollbar,
+.project-sidebar::-webkit-scrollbar,
+::-webkit-scrollbar {
+  width: 0 !important;
+  height: 0 !important;
+  display: none !important;
+  background: transparent !important;
+}
+
+* {
+  scrollbar-width: none !important;
+}
+
+/* 2. Utility View Buttons (Top Right Actions) */
+.utility-view .project-header__actions button {
+  padding: 6px 14px !important;
+  border-radius: 999px !important;
+  background: rgba(255, 255, 255, 0.05) !important;
+  border: 1px solid rgba(255, 255, 255, 0.1) !important;
+  color: rgba(255, 255, 255, 0.75) !important;
+  font-size: 10px !important;
+  font-weight: 500 !important;
+  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
+}
+
+.utility-view .project-header__actions button:hover {
+  background: rgba(255, 255, 255, 0.12) !important;
+  color: #fff !important;
+  border-color: rgba(255, 255, 255, 0.2) !important;
+  transform: scale(1.03) !important;
+}
+
+.utility-view .project-header__actions button:active {
+  transform: scale(0.96) !important;
+}
+
+/* Fix Icon alignments */
+.tone-console-dock__icon svg,
+.tone-console__close-btn svg {
+  display: inline-block !important;
+  vertical-align: middle !important;
+  font-size: 1.2em !important;
+}
+
+/* ==========================================================================
+   IMPECCABLE OVERRIDES: PHASE 16 (PANORAMIC POLISH)
+   ========================================================================== */
+
+/* 1. Empty State Animation (Breathing AI Signal) */
+@keyframes signal-pulse-pro {
+  0%, 100% {
+    transform: scaleY(0.75);
+    opacity: 0.6;
+    box-shadow: 0 0 0 transparent;
+  }
+  50% {
+    transform: scaleY(1);
+    opacity: 1;
+    box-shadow: 0 0 10px rgba(167, 139, 250, 0.9);
+  }
+}
+
+.project-empty-state__signal i {
+  animation: signal-pulse-pro 2s ease-in-out infinite !important;
+  transform-origin: center !important;
+  background: #ffffff !important;
+  transition: none !important;
+}
+.project-empty-state__signal i:nth-child(1) {
+  animation-delay: 0s !important;
+}
+.project-empty-state__signal i:nth-child(2) {
+  animation-delay: 0.3s !important;
+}
+.project-empty-state__signal i:nth-child(3) {
+  animation-delay: 0.6s !important;
+}
+
+/* 2. Candidate & Empty State Primary Buttons: Crystal Glass instead of Flat Gradient */
+.primary-action,
+.candidate-stage__actions button:last-child,
+.candidate-stage__actions .primary-action,
+.project-empty-state__primary {
+  background: rgba(167, 139, 250, 0.15) !important;
+  color: #fff !important;
+  border: 1px solid rgba(167, 139, 250, 0.3) !important;
+  box-shadow: 
+    inset 0 1px 1px rgba(255, 255, 255, 0.3),
+    0 2px 12px rgba(167, 139, 250, 0.25) !important;
+  font-weight: 500 !important;
+  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6) !important;
+  backdrop-filter: blur(8px) saturate(150%) !important;
+  -webkit-backdrop-filter: blur(8px) saturate(150%) !important;
+}
+
+.primary-action:hover:not(:disabled),
+.candidate-stage__actions button:last-child:hover:not(:disabled),
+.candidate-stage__actions .primary-action:hover:not(:disabled),
+.project-empty-state__primary:hover:not(:disabled) {
+  background: rgba(167, 139, 250, 0.25) !important;
+  box-shadow: 
+    inset 0 1px 1px rgba(255, 255, 255, 0.5),
+    0 4px 16px rgba(167, 139, 250, 0.4) !important;
+  border-color: rgba(167, 139, 250, 0.5) !important;
+  color: #fff !important;
+  filter: none !important;
+  transform: scale(1.03) !important;
+}
+
+.primary-action:active:not(:disabled),
+.candidate-stage__actions button:last-child:active:not(:disabled),
+.candidate-stage__actions .primary-action:active:not(:disabled),
+.project-empty-state__primary:active:not(:disabled) {
+  transform: scale(0.96) !important;
+}
+
+/* 3. Agent Unavailable Error State Polish */
+.agent-chat__message--error {
+  background: rgba(220, 38, 38, 0.1) !important;
+  backdrop-filter: blur(12px) !important;
+  -webkit-backdrop-filter: blur(12px) !important;
+  border: 1px solid rgba(220, 38, 38, 0.3) !important;
+  box-shadow: 
+    inset 0 1px 1px rgba(255, 255, 255, 0.1),
+    0 4px 12px rgba(220, 38, 38, 0.1) !important;
+}
+.agent-chat__message--error small {
+  color: #f87171 !important;
+  font-weight: 600 !important;
+  letter-spacing: 0.5px !important;
+  text-shadow: 0 0 8px rgba(248, 113, 113, 0.4) !important;
+}
+.agent-chat__message--error p {
+  color: #fecaca !important;
+}
+/* ==========================================================================
+   IMPECCABLE OVERRIDES: PHASE 17 (CANDIDATE HIGHLIGHT & PREMIUM ERROR)
+   ========================================================================== */
+
+/* 1. Candidate Clip Luminous Highlight */
+.arrangement-map__clip[data-candidate="true"] {
+  box-shadow: 
+    inset 0 0 0 1px rgba(255, 255, 255, 0.6),
+    inset 0 2px 4px rgba(255, 255, 255, 0.3),
+    0 0 16px var(--track-color) !important;
+  filter: brightness(1.25) saturate(1.3) !important;
+  background-image: linear-gradient(135deg, rgba(255,255,255,0.25), transparent) !important;
+  animation: candidate-pulse 2s ease-in-out infinite alternate !important;
+  z-index: 10 !important;
+}
+
+@keyframes candidate-pulse {
+  from { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.4), 0 0 8px var(--track-color); }
+  to { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.8), 0 0 24px var(--track-color); }
+}
+
+/* Dim non-candidate clips in review mode */
+.arrangement-map[data-review-mode="true"] .arrangement-map__clip:not([data-candidate="true"]) {
+  opacity: 0.35 !important;
+  filter: grayscale(0.6) brightness(0.7) !important;
+}
+
+/* 2. Apple-Grade Error State (AGENT_UNAVAILABLE) */
+.agent-chat__message--error {
+  position: relative !important;
+  background: rgba(30, 10, 10, 0.6) !important; /* Deep dark crimson */
+  backdrop-filter: blur(24px) saturate(150%) !important;
+  -webkit-backdrop-filter: blur(24px) saturate(150%) !important;
+  border: 1px solid rgba(255, 50, 50, 0.15) !important;
+  border-top: 1px solid rgba(255, 50, 50, 0.25) !important;
+  box-shadow: 
+    inset 0 1px 0 rgba(255, 100, 100, 0.1),
+    0 8px 24px rgba(0, 0, 0, 0.4) !important;
+  border-radius: 12px !important;
+  overflow: hidden !important;
+}
+
+.agent-chat__message--error::before {
+  content: '' !important;
+  position: absolute !important;
+  top: 0 !important; left: 0 !important; bottom: 0 !important;
+  width: 3px !important;
+  background: #ff453a !important; /* iOS red */
+  box-shadow: 0 0 8px #ff453a !important;
+}
+
+.agent-chat__message--error small {
+  display: block !important;
+  color: #ff453a !important;
+  font-size: 10px !important;
+  font-weight: 700 !important;
+  letter-spacing: 0.8px !important;
+  text-transform: uppercase !important;
+  margin-bottom: 4px !important;
+  text-shadow: 0 0 12px rgba(255, 69, 58, 0.5) !important;
+}
+
+.agent-chat__message--error p {
+  color: rgba(255, 255, 255, 0.85) !important;
+  font-size: 13px !important;
+  line-height: 1.4 !important;
+}
+
